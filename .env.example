# Server-only encryption key: at least 32 characters. In production, it is generated and persisted in DATA_DIR by the Node service.
CONNECTION_ENCRYPTION_KEY=
# Optional default model account, only needed if the site owner wants a shared default.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# Optional SkillHub team key, only on the server if the public API requires it.
SKILLHUB_API_KEY=
# HTTPS deployment only; keep unset for local development.
PUBLIC_ORIGIN=
DATA_DIR=
PORT=3000

# Platform-provided E2B account; never exposed in end-user settings.
E2B_API_KEY=
# Optional E2B template; leave empty to use the default base template.
E2B_TEMPLATE_ID=
